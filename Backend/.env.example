# ─── Aurum Markets Backend — environment reference ───────────────────────────
# Copy to .env and adjust. NEVER commit .env. All secrets come from env only.

# Core
NODE_ENV=development
PORT=4000
# Public origin of the frontend (for CORS + cookies)
FRONTEND_ORIGIN=http://localhost:3000

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://aurum:aurum@localhost:5432/aurum?schema=public

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Session cookie
SESSION_COOKIE_NAME=aurum_session
# Session lifetime in days
SESSION_TTL_DAYS=7
# Secret used to sign cookies (change in every environment)
COOKIE_SECRET=dev-only-cookie-secret-change-me

# TOTP / 2FA
TOTP_ISSUER=Aurum Markets

# ─── Demo-first safety flags (see CLAUDE.md principle #3) ─────────────────────
# Real-money trading and live payouts stay OFF until a CMA licence exists.
LIVE_TRADING=false
LIVE_PAYMENTS=false

# ─── M-Pesa Daraja (Phase 4 — sandbox only until licensed) ───────────────────
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_BASE_URL=

# ─── Real market-data adapter (Phase 2 — off by default; SimulatedFeed used) ──
# FEED_ADAPTER=simulated
# FINNHUB_API_KEY=
